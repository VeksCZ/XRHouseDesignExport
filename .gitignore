# This .gitignore file should be placed at the root of your Unity project.
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryDumps
*.lspd

# Asset meta data shouldn't be ignored
!/[Aa]ssets/**/*.meta

# Logs - almost always generated and not needed in Git
*.log

# Project-specific exports (ignore runtime generated data)
/Exports/
/RoomExports_FromQuest/

# Root level text/csv files (usually temporary or local logs)
/*.txt
/*.csv
!/README.md
!/LICENSE

# Note: We allow .txt and .csv inside Assets/ because many packages 
# (like TextMesh Pro) use them for licenses or configuration.

# Android/Unity Builds
/Build/
/Builds/

# Autogenerated JetBrains Rider project files
.idea/

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Android Studio project files
*.iml
.cxx/
capture/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file extensions to ignore
*.unitypackage
*.exclude

# Windows design file temporary files
ShellClassInfo
thumbs.db
Desktop.ini

# Windows Shortcut
*.lnk

# macOS junk
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# AiFamiliar - API keys and sensitive data (auto-added by AI Familiar plugin)
Assets/AiFamiliarData/.api_keys.json
Assets/AiFamiliarData/.api_keys.json.meta
Assets/AiFamiliarData/Settings/

# Generated by the editor build (timestamp shown in the app)
/Assets/Resources/BuildInfo.txt

# Meta XR Operator's native API layer (DLL + JSON), auto-registered per machine by the
# Project Setup Tool - a machine-local binary, not project config, and Unity already
# excludes '~'-suffixed folders from the asset pipeline.
/Assets/XR/APILayers~/
/Assets/Resources/BuildInfo.txt.meta

# Unity editor crash recovery scenes and Test Runner temp scenes
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta

# Meta XR SDK per-machine/session ids
/[Aa]ssets/#Meta/
/[Aa]ssets/#Meta.meta

# Android native (CMake/Ninja) build cache
/.utmp/

# Local project backups
/Backups/

# Other Unity generated / local data
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab

# Claude Code: local settings and the Meta XR Operator skills it installs per machine
/.claude/settings.local.json
/.claude/skills/meta-xr-operator*/

# Generated by the Meta XR SDK at build time (runtime input action bindings)
/Assets/StreamingAssets/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json.meta
