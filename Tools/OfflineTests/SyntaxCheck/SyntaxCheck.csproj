<!-- Parses every script of the project (defines UNITY_EDITOR;UNITY_ANDROID;META_XR_SDK_INSTALLED) and prints syntax errors:
     a quick sanity check without Unity.
       cd Tools/OfflineTests/SyntaxCheck, then: dotnet run -c Release (pass the Assets folder as the argument) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" /></ItemGroup>
</Project>
