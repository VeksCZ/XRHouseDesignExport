<!-- Offline check of the "Missing wall" logic (MissingWall.Find, SceneJsonEdit.AddWall for the V1 and V2 scan formats) on a
     synthetic room, with minimal stand-ins for the Unity types (Stubs.cs). Not part of the Unity project (outside Assets).
       cd Tools/OfflineTests/WallTest, then: dotnet run -c Release
     In a cloud session without dotnet: apt-get install -y dotnet-sdk-8.0 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable>
    <DefineConstants>META_XR_SDK_INSTALLED</DefineConstants><NoWarn>CS0649;CS0169;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../../../Assets/Scripts/SceneJsonEdit.cs" />
    <Compile Include="../../../Assets/Scripts/MissingWall.cs" />
    <Compile Include="../../../Assets/Scripts/StairFloorSnap.cs" />
    <Compile Include="../../../Assets/Scripts/FrameCulling.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
